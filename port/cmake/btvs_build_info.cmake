# Writes btvs_build_info.h (BTVS_GIT_COMMIT) when the commit changed.
execute_process(COMMAND git -C "${SRC}" rev-parse --short=10 HEAD OUTPUT_VARIABLE H OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
execute_process(COMMAND git -C "${SRC}" status --porcelain --untracked-files=no OUTPUT_VARIABLE D OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(NOT H)
    set(H "unknown")
endif()
if(D)
    set(H "${H}+changes")
endif()
set(TEXT "#define BTVS_GIT_COMMIT \"${H}\"\n")
set(OLD "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" OLD)
endif()
if(NOT OLD STREQUAL TEXT)
    file(WRITE "${OUT}" "${TEXT}")
endif()
